@*model string[]*@
@model List<string[]>


@{
    ViewData["Title"] = "Page Hits Log";
}

<h2>@ViewData["PageName"] @ViewData["Title"]</h2>

@if (Model.Count == 0)
{
    <p>No hits recorded yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>When (Central Time)</th>
               
                <th>From Where (host app)</th>
                <th>Device</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var parts in Model)
        {
            //var parts = line.Split('|');
            <tr>
                <td>@(parts.Length > 0 ? parts[0].Trim() : "")</td>
              
                <td>@(parts.Length > 2 ? parts[2].Trim() : "")</td>
                <td>@(parts.Length > 3 ? parts[3].Trim() : "")</td>
            </tr>
        }
        </tbody>

    </table>
}
